# Copy this file to .env.local, then fill in the two REQUIRED values. Everyone
# develops against the team's existing hosted Supabase project; nothing runs in
# Docker. On Vercel, set the same variables in Project Settings > Environment
# Variables (docs/deployment.md).
# .env.local is gitignored. Never commit real values, and never paste keys into chat.

# ---------------------------------------------------------------------------
# REQUIRED: the hosted Supabase project. Supabase Dashboard > Project Settings >
# API Keys, or ask the migration owner (npm run env:share). Both are designed to
# be public, because RLS protects the data.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ---------------------------------------------------------------------------
# OPTIONAL: EmberGap data sources and agents. All server-only.
# Without them the app runs on labelled synthetic fixtures.
# ---------------------------------------------------------------------------
# NASA_FIRMS_MAP_KEY=                # NASA FIRMS Area API key (Outrolife's adapter).
# Open-Meteo and NASA EONET need no key.
#
# SUPABASE_SECRET_KEY=               # Server-only and bypasses RLS. Set it ONLY in Vercel and on the
#                                    # migration owner's machine: agent workers use it to record findings.
#                                    # Without it, reports still work and agents are simply not run.

# ---------------------------------------------------------------------------
# OPTIONAL: AI utilities (src/lib/ai). AI stays off until one of these is set.
# ---------------------------------------------------------------------------
# AI_PROVIDER=mock                   # Offline fake responses. No key, no cost.
# ANTHROPIC_API_KEY=                 # Server-only. Never add a NEXT_PUBLIC_ prefix.
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=medium                   # low | medium | high | xhigh | max
# AI_MAX_TOKENS=16000

# ---------------------------------------------------------------------------
# OPTIONAL: sponsor and external integrations (src/lib/integrations).
# All server-only: never add a NEXT_PUBLIC_ prefix. Check them at /dev/integrations.
# See docs/integrations.md and docs/sponsor-strategy.md.
# ---------------------------------------------------------------------------
# ELEVENLABS_API_KEY=                # Off until set. Free plan: 10,000 credits a month, 2 requests at once.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # "George", from ElevenLabs' quickstart.
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5      # Fastest, and half the price of Multilingual v2.
# ELEVENLABS_MAX_CHARACTERS_PER_DAY=5000     # Per server instance.
# N8N_WEBHOOK_URL=                   # A production Webhook URL, or http://localhost:5678/webhook/... for npx n8n.
# N8N_WEBHOOK_SECRET=                # 16+ characters. The Webhook node's Header Auth value for X-N8N-Secret.
# N8N_CALLBACK_SECRET=               # Only if n8n calls the app back, as a Bearer token.
# FIRECRAWL_API_KEY=                 # Off until set. Free plan: 1,000 credits, 10 requests a minute.
# FIRECRAWL_MAX_REQUESTS_PER_DAY=100 # Per server instance. A JSON extraction costs 5 credits.
# FIRECRAWL_API_URL=https://api.firecrawl.dev   # Without /v2. Only for self-hosted Firecrawl.
# GITHUB_API_TOKEN=                  # Optional fine-grained token. Without it: 60 requests an hour.
# GITHUB_WEBHOOK_SECRET=             # Only if you receive GitHub webhooks.
# EMBERGAP_FIRMS_MODE=               # live or demo. Unset: live when NASA_FIRMS_MAP_KEY is set, else labelled synthetic demo data.
# NASA_FIRMS_MAP_KEY=                # Free at firms.modaps.eosdis.nasa.gov/api/map_key. Server-only.
# NASA_FIRMS_SOURCE=VIIRS_SNPP_NRT   # Or VIIRS_NOAA20_NRT, VIIRS_NOAA21_NRT, MODIS_NRT, LANDSAT_NRT.

# ---------------------------------------------------------------------------
# OPTIONAL: production builds only
# ---------------------------------------------------------------------------
# ENABLE_DEV_TOOLS=true              # Serves /dev in a production build. Off by default.

# ---------------------------------------------------------------------------
# TESTS (migration owner): never in .env.local.
# ---------------------------------------------------------------------------
# Integration and hosted E2E tests read SUPABASE_TEST_URL and
# SUPABASE_TEST_PUBLISHABLE_KEY from .env.test.local, which `npm run env:test`
# writes for you. SUPABASE_TEST_SECRET_KEY is optional. Keep them out of .env.local.
