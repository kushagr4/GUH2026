# Copy this file to .env.local and fill in the two required values.
#   cp .env.example .env.local
# .env.local is gitignored. Never commit real values, and never paste keys into chat.

# ---------------------------------------------------------------------------
# REQUIRED: the team's shared Supabase project
# Ask the migration owner, or copy from Supabase Dashboard > Project Settings >
# API Keys. Both are designed to be public, because RLS protects the data.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ---------------------------------------------------------------------------
# OPTIONAL: AI utilities (src/lib/ai). AI stays off until one of these is set.
# ---------------------------------------------------------------------------
# AI_PROVIDER=mock                   # Offline fake responses. No key, no cost.
# ANTHROPIC_API_KEY=                 # Server-only. Never add a NEXT_PUBLIC_ prefix.
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=medium                   # low | medium | high | xhigh | max
# AI_MAX_TOKENS=16000

# ---------------------------------------------------------------------------
# OPTIONAL: production builds only
# ---------------------------------------------------------------------------
# ENABLE_DEV_TOOLS=true              # Serves /dev in a production build. Off by default.

# ---------------------------------------------------------------------------
# MIGRATION OWNER ONLY. Other developers do not need these.
# ---------------------------------------------------------------------------
# SUPABASE_SECRET_KEY=               # Server-only. It bypasses RLS. Nothing in the app needs it today.
#
# Integration and hosted E2E tests read SUPABASE_TEST_URL and
# SUPABASE_TEST_PUBLISHABLE_KEY from .env.test.local, which `npm run env:test`
# writes for you. SUPABASE_TEST_SECRET_KEY is optional. Keep them out of .env.local.
