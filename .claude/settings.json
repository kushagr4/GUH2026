{
  "permissions": {
    "deny": [
      "Bash(npx supabase projects api-keys*)",
      "Bash(supabase projects api-keys*)",
      "PowerShell(npx supabase projects api-keys*)",
      "PowerShell(supabase projects api-keys*)",
      "Bash(npx supabase projects delete*)",
      "Bash(supabase projects delete*)",
      "PowerShell(npx supabase projects delete*)",
      "PowerShell(supabase projects delete*)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(npx supabase start*)",
      "Bash(npx supabase stop*)",
      "Bash(npx supabase db reset*)",
      "Bash(npx supabase branches *)",
      "Bash(supabase start*)",
      "Bash(supabase stop*)",
      "Bash(supabase db reset*)",
      "Bash(supabase branches *)",
      "PowerShell(docker *)",
      "PowerShell(docker-compose *)",
      "PowerShell(npx supabase start*)",
      "PowerShell(npx supabase stop*)",
      "PowerShell(npx supabase db reset*)",
      "PowerShell(npx supabase branches *)",
      "PowerShell(supabase start*)",
      "PowerShell(supabase stop*)",
      "PowerShell(supabase db reset*)",
      "PowerShell(supabase branches *)",
      "mcp__supabase__create_project",
      "mcp__supabase__pause_project",
      "mcp__supabase__create_branch",
      "mcp__supabase__delete_branch",
      "mcp__supabase__merge_branch",
      "mcp__supabase__reset_branch",
      "mcp__supabase__rebase_branch",
      "Bash(gh pr merge*)",
      "PowerShell(gh pr merge*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking the git guard"
          }
        ]
      }
    ]
  }
}
